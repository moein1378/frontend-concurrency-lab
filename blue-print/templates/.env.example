# Optional public values for apps/lab; startup requires no environment file.
# Verified 2026-11-14; baseline 19640ebd8169ce625b2a093caafc1ca2483b6a84 + working tree.
# Evidence (repo-root relative): .env.example, apps/lab/vite.config.ts,
# apps/lab/src/modules/search-race/SearchRaceLab.vue. Source confidence: high.
# Recheck those inputs after environment/build changes; values are not secrets.
# Copy to apps/lab/.env.local only when overriding defaults (Vite's app root).
# Never place secrets in VITE_* variables.
VITE_DEMO_SEED=concurrency-v1
# VITE_BASE_PATH is read by config from process.env: supply through shell/CI,
# not this file. Example: VITE_BASE_PATH=/frontend-concurrency-lab/ pnpm build:demo
